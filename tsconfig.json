{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./server",
    "rootDir": "./server/src"
  },
  "include": ["server/src/**/*.ts"],
  "exclude": ["node_modules"]
}

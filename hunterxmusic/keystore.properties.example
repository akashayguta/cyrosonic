# ============================================================================
#  TEMPLATE — copy this file to  keystore.properties  (same folder) and fill in
#  your real values. keystore.properties is gitignored and must NEVER be
#  committed. This .example file is safe to commit as documentation.
#
#  storeFile can be an absolute path (e.g. C:\\Users\\sande\\keys\\cyrosonic.jks)
#  or a path relative to this project root (e.g. cyrosonic-release.jks).
#  On Windows, either use forward slashes or escape backslashes as \\ .
# ============================================================================
storeFile=cyrosonic-release.jks
storePassword=CHANGE_ME
keyAlias=cyrosonic
keyPassword=CHANGE_ME
